modules = ["nodejs-20", "web", "python-base-3.13"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 3013
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 23636
externalPort = 3001

[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "start"]
build = ["npm", "run", "build"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[agent]
expertMode = true
stack = "FULLSTACK_JS"

[userenv]

[userenv.development]
PIDGE_POC_MOBILE = "9619590694"
PIDGE_POC_NAME = "Fresh Stock Xchange"
PIDGE_SENDER_ADDRESS_LINE_1 = "Flat no- 805/A Wing, 8th Floor"
PIDGE_SENDER_ADDRESS_LINE_2 = "Hubtown Greenwood CHS, Pokhran Road No.1, Vartak Nagar"
PIDGE_SENDER_CITY = "Thane"
PIDGE_SENDER_COUNTRY = "India"
PIDGE_SENDER_MOBILE = "9619590694"
PIDGE_SENDER_NAME = "Fresh Stock Xchange"
PIDGE_SENDER_PINCODE = "400606"
PIDGE_SENDER_STATE = "Maharashtra"
