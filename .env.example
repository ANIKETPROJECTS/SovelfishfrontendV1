# FishTokri — required environment variables
# Copy this file to .env on your VPS and replace the placeholders.
# Keep the real .env out of Git. Replit uses its own Secrets/env vars.

# MongoDB connection string (required — app will not start without this)
MONGODB_URI=mongodb://user:password@host:27017/?authSource=admin

# Express session secret (required)
SESSION_SECRET=change_me_to_a_long_random_string

# Razorpay payment gateway (required for checkout)
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...

# Razorpay webhook secret — prevents spoofed webhook requests.
# Get this from: Razorpay Dashboard → Settings → Webhooks → (your webhook) → Secret.
# The webhook URL to register there is: https://<your-domain>/api/webhooks/razorpay
# Select the "payment.captured" event.
RAZORPAY_WEBHOOK_SECRET=...

# Razorpay publishable key exposed to the React bundle (same value as RAZORPAY_KEY_ID)
VITE_RAZORPAY_KEY_ID=rzp_live_...

# Google Maps API key exposed to the React bundle (domain-restricted, not a secret)
VITE_GOOGLE_MAPS_API_KEY=AIza...

# WhatsApp / Admark messaging (optional — notifications are skipped if missing)
ADMARK_API_KEY=...
ADMARK_PHONE_NUMBER_ID=...

# Server port (default: 3023)
PORT=3023
